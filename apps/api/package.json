{
  "name": "@ciphermesh/api",
  "version": "0.0.0",
  "private": true,
  "description": "CipherMesh Express API and worker (foundation only in Phase 1).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@ciphermesh/shared": "workspace:*",
    "@ciphermesh/validation": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "express": "5.2.1",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
