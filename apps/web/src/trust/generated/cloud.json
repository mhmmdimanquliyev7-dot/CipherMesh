  "exposure": [
    {
      "endpoint": "Nginx HTTPS, application host",
      "exposedTo": "Internet",
      "port": "443",
      "notes": "TLS 1.2 and 1.3 (CP-21); unknown host names get no TLS handshake"
    },
    {
      "endpoint": "Nginx HTTPS, storage host",
      "exposedTo": "Internet",
      "port": "443",
      "notes": "Only signed requests for /<bucket>/f/<key>; cookies refused; listing, other buckets and every SeaweedFS endpoint refused"
    },
    {
      "endpoint": "Nginx HTTP",
      "exposedTo": "Internet",
      "port": "80",
      "notes": "Redirect to HTTPS and ACME challenges only"
    },
    {
      "endpoint": "SSH",
      "exposedTo": "The operator's address (security list)",
      "port": "22",
      "notes": "Key authentication only, no root, AllowUsers"
    },
    {
      "endpoint": "API",
      "exposedTo": "Nginx only, internal app network",
      "port": "none published",
      "notes": ""
    },
    {
      "endpoint": "Worker",
      "exposedTo": "No inbound",
      "port": "none",
      "notes": "One-shot container started by a timer"
    },
    {
      "endpoint": "PostgreSQL",
      "exposedTo": "API and worker on the internal data network; the ops container on its loopback",
      "port": "none published",
      "notes": "hostssl with SCRAM for runtime roles; superuser by peer only"
    },
    {
      "endpoint": "SeaweedFS (S3, master, volume, filer)",
      "exposedTo": "Nginx on the internal storage network",
      "port": "none published",
      "notes": "IAM API off; one identity limited to the content bucket"
    },
    {
      "endpoint": "Docker socket",
      "exposedTo": "Nobody",
      "port": "not applicable",
      "notes": "Root-only, never mounted into a container"
    }
  ]
