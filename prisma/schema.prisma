// CipherMesh schema v1 (CM-T013). Authoritative design: docs/architecture/data-model.md.
//
// Rules for this file:
// - Every scalar field carries a `/// class:` comment with its data-model classification
//   (ID, META, PII, CT, WK, SENC, DIG, INT, PUBK). `pnpm db:check-schema` fails on an
//   unclassified field, a forbidden field name or a ciphertext field that is not bytea.
// - The database stores ciphertext, wrapped keys, digests and metadata only. It never stores
//   passwords, Vault Passphrases, private keys, room key material, DEKs or content in plaintext
//   (INV-01, INV-04, INV-16; data-model section 6).
// - Relations use Restrict. Rows are tombstoned instead of cascade-deleted (data-model section 5).
// - CHECK constraints, triggers and grants live in hand-written migrations because Prisma cannot
//   express them. They are tested in tests/database.
// - Identifiers are UUIDv4. IDs used in cryptographic contexts (key pairs, rooms, files, notes,
//   secrets) are generated by the client and have no database default. Unpredictable IDs are not
//   authorization: every room-scoped query still filters by room and membership (INV-06).

generator client {
  provider        = "prisma-client"
  output          = "../apps/api/src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------------------------

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionRevokeReason {
  LOGOUT
  REVOKED_BY_USER
  REVOKED_BY_ADMIN
  PASSWORD_CHANGED
  MFA_CHANGED
  RECOVERY_CODE_USED
  VAULT_RESET
  PLATFORM_ROLE_CHANGED
  ACCOUNT_DISABLED
  SESSION_LIMIT
}

enum LoginOutcome {
  SUCCESS
  BAD_CREDENTIALS
  MFA_FAILED
  THROTTLED
  DISABLED
}

enum KeyPairStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
}

enum SecurityProfile {
  STANDARD
  CONFIDENTIAL
  RESTRICTED
}

enum RoomStatus {
  ACTIVE
  DELETING
  DELETED
}

enum RoomKeyState {
  ACTIVE
  REKEY_REQUIRED
  REKEYING
}

enum RekeyReason {
  MEMBER_REMOVED
  MEMBER_LEFT
  MEMBER_SUSPENDED
  MEMBER_DELETED
  IDENTITY_KEY_COMPROMISED
  CRYPTOPERIOD_EXPIRED
  WRAP_LIMIT_REACHED
}

enum KeyVersionReason {
  INITIAL
  MANUAL
  POLICY_CHANGE
  MEMBER_REMOVED
  MEMBER_LEFT
  MEMBER_SUSPENDED
  MEMBER_DELETED
  IDENTITY_KEY_COMPROMISED
  CRYPTOPERIOD_EXPIRED
  WRAP_LIMIT_REACHED
}

enum RoomRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// OWNER is never granted by invitation, so it is not representable here.
enum InvitationRole {
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
  LEFT
}

enum RemovalReason {
  REMOVED_BY_ADMIN
  LEFT_ROOM
  ACCOUNT_DISABLED
  ACCOUNT_DELETED
}

enum InvitationStatus {
  PENDING_APPROVAL
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum KeyVersionStatus {
  ACTIVE
  RETIRED
  DESTROYED
}

enum RekeyMode {
  MANDATORY
  MANUAL
}

enum RekeyStatus {
  PENDING
  COMPLETED
  ABANDONED
  SUPERSEDED
  CANCELLED
  STALE
}

enum EnvelopeStatus {
  PENDING
  ACTIVE
}

enum FileStatus {
  PENDING_UPLOAD
  AVAILABLE
  DELETED
}

enum SecretStatus {
  ACTIVE
  REVEALED
  EXPIRED
  REVOKED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

// ---------------------------------------------------------------------------------------------
// Accounts and sessions
// ---------------------------------------------------------------------------------------------

/// data-model 4.1. Never hard-deleted. The password is stored only as an Argon2id hash (INV-11).
model User {
  /// class: ID
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: PII (login identifier, not verified; T-35)
  email             String       @unique @db.Citext
  /// class: PII
  displayName       String       @map("display_name") @db.VarChar(80)
  /// class: DIG (Argon2id PHC string, a one-way hash; never an encrypted password)
  passwordHash      String       @map("password_hash") @db.VarChar(256)
  /// class: META
  passwordChangedAt DateTime     @map("password_changed_at") @db.Timestamptz(3)
  /// class: META
  platformRole      PlatformRole @default(USER) @map("platform_role")
  /// class: META
  status            UserStatus   @default(ACTIVE)
  /// class: META
  mfaEnabled        Boolean      @default(false) @map("mfa_enabled")
  /// class: SENC (AES-256-GCM under the server TOTP key held outside the database, CP-11)
  mfaTotpSecretEnc  Bytes?       @map("mfa_totp_secret_enc")
  /// class: META
  mfaTotpKeyId      String?      @map("mfa_totp_key_id") @db.VarChar(64)
  /// class: META
  mfaLastUsedStep   BigInt?      @map("mfa_last_used_step")
  /// class: META
  failedLoginCount  Int          @default(0) @map("failed_login_count")
  /// class: META
  throttledUntil    DateTime?    @map("throttled_until") @db.Timestamptz(3)
  /// class: META
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// class: META
  lastLoginAt       DateTime?    @map("last_login_at") @db.Timestamptz(3)
  /// class: META
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)

  sessions            Session[]
  recoveryCodes       RecoveryCode[]
  loginAttempts       LoginAttempt[]
  keyPairs            UserKeyPair[]
  roomsCreated        Room[]           @relation("RoomCreatedBy")
  memberships         RoomMember[]     @relation("MemberUser")
  membershipsAdded    RoomMember[]     @relation("MemberAddedBy")
  membershipsRemoved  RoomMember[]     @relation("MemberRemovedBy")
  invitationsReceived Invitation[]     @relation("InvitationInvitee")
  invitationsSent     Invitation[]     @relation("InvitationInvitedBy")
  invitationsApproved Invitation[]     @relation("InvitationApprovedBy")
  keyVersionsCreated  RoomKeyVersion[] @relation("KeyVersionCreatedBy")
  rekeysStarted       RekeyOperation[]
  envelopesCreated    KeyEnvelope[]    @relation("EnvelopeCreatedBy")
  filesUploaded       EncryptedFile[]
  notesAuthored       EncryptedNote[]  @relation("NoteAuthor")
  notesUpdated        EncryptedNote[]  @relation("NoteUpdatedBy")
  secretsSent         Secret[]         @relation("SecretSender")

  @@map("users")
}

/// data-model 4.2. Digests of high-entropy single-use codes; the codes are never stored (CP-10).
model RecoveryCode {
  /// class: ID
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: ID
  userId     String    @map("user_id") @db.Uuid
  /// class: DIG (SHA-256 of the code)
  codeDigest Bytes     @unique @map("code_digest")
  /// class: META
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  /// class: META
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("recovery_codes")
}

/// data-model 4.3. Only the SHA-256 digest of the opaque session token is stored (INV-12).
model Session {
  /// class: ID
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: ID
  userId            String               @map("user_id") @db.Uuid
  /// class: DIG (SHA-256 of the 256-bit token)
  tokenDigest       Bytes                @unique @map("token_digest")
  /// class: META
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  lastSeenAt        DateTime             @map("last_seen_at") @db.Timestamptz(3)
  /// class: META
  idleExpiresAt     DateTime             @map("idle_expires_at") @db.Timestamptz(3)
  /// class: META
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz(3)
  /// class: META
  authenticatedAt   DateTime             @map("authenticated_at") @db.Timestamptz(3)
  /// class: META
  mfaVerifiedAt     DateTime?            @map("mfa_verified_at") @db.Timestamptz(3)
  /// class: META
  stepUpAt          DateTime?            @map("step_up_at") @db.Timestamptz(3)
  /// class: PII (retention-limited)
  ipAddress         String?              @map("ip_address") @db.Inet
  /// class: PII (retention-limited)
  userAgent         String?              @map("user_agent") @db.VarChar(512)
  /// class: META
  rotatedAt         DateTime?            @map("rotated_at") @db.Timestamptz(3)
  /// class: META
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(3)
  /// class: META
  revokeReason      SessionRevokeReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Session list and the 10-session limit per user; worker cleanup 30 days after expiry.
  @@index([userId, absoluteExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// data-model 4.4. Never stores the submitted password or the raw identifier of an unknown account.
model LoginAttempt {
  /// class: ID
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: META
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// class: ID (set only when the identifier matches an account)
  userId         String?      @map("user_id") @db.Uuid
  /// class: DIG (HMAC-SHA-256 of an unknown identifier under a server key, CP-12)
  identifierHmac Bytes?       @map("identifier_hmac")
  /// class: PII (retention 90 days)
  ipAddress      String?      @map("ip_address") @db.Inet
  /// class: PII (retention 90 days)
  userAgent      String?      @map("user_agent") @db.VarChar(512)
  /// class: META
  outcome        LoginOutcome

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Rate limiting per account and per unknown identifier; 90-day retention sweep.
  @@index([userId, occurredAt])
  @@index([identifierHmac, occurredAt])
  @@index([occurredAt])
  @@map("login_attempts")
}

/// data-model 4.5. The private key is stored only as AES-256-GCM ciphertext under PKWK, which is
/// derived in the browser from the Vault Passphrase. The server cannot decrypt it.
model UserKeyPair {
  /// class: ID (client-generated keyId; part of the private-key AAD)
  id                   String        @id @db.Uuid
  /// class: ID
  userId               String        @map("user_id") @db.Uuid
  /// class: META
  status               KeyPairStatus @default(ACTIVE)
  /// class: META
  algorithmSuite       String        @map("algorithm_suite") @db.VarChar(16)
  /// class: PUBK (RSA-3072 SPKI, DER)
  publicKeySpki        Bytes         @map("public_key_spki")
  /// class: INT (hex SHA-256 of the SPKI, CP-17)
  publicKeyFingerprint String        @unique @map("public_key_fingerprint") @db.Char(64)
  /// class: CT (AES-256-GCM of the PKCS#8 private key under PKWK; NULL once SUPERSEDED or REVOKED)
  encryptedPrivateKey  Bytes?        @map("encrypted_private_key")
  /// class: META (IV, not secret)
  privateKeyIv         Bytes         @map("private_key_iv")
  /// class: META
  kdfAlgorithm         String        @map("kdf_algorithm") @db.VarChar(16)
  /// class: META
  kdfMemoryKiB         Int           @map("kdf_memory_kib")
  /// class: META
  kdfIterations        Int           @map("kdf_iterations")
  /// class: META
  kdfParallelism       Int           @map("kdf_parallelism")
  /// class: META (salt, not secret)
  kdfSalt              Bytes         @map("kdf_salt")
  /// class: META
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  supersededAt         DateTime?     @map("superseded_at") @db.Timestamptz(3)
  /// class: META
  revokedAt            DateTime?     @map("revoked_at") @db.Timestamptz(3)

  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  envelopes           KeyEnvelope[]
  secretsReceived     Secret[]
  invitationsReceived Invitation[]

  // Composite key target: envelopes, secrets and invitations prove the key belongs to the user.
  @@unique([id, userId])
  @@unique([userId], map: "user_key_pairs_one_active_per_user", where: raw("status = 'ACTIVE'"))
  @@map("user_key_pairs")
}

// ---------------------------------------------------------------------------------------------
// Rooms, membership and room keys
// ---------------------------------------------------------------------------------------------

/// data-model 4.6. The name is not encrypted; the UI warns users not to put secrets in it.
model Room {
  /// class: ID (client-generated; part of every room cryptographic context)
  id                 String          @id @db.Uuid
  /// class: META
  name               String          @db.VarChar(100)
  /// class: META
  securityProfile    SecurityProfile @map("security_profile")
  /// class: META
  policyVersion      Int             @map("policy_version")
  /// class: META
  currentKeyVersion  Int             @default(1) @map("current_key_version")
  /// class: META
  keyState           RoomKeyState    @default(ACTIVE) @map("key_state")
  /// class: META
  rekeyReasons       RekeyReason[]   @default([]) @map("rekey_reasons")
  /// class: META
  rekeyRequiredSince DateTime?       @map("rekey_required_since") @db.Timestamptz(3)
  /// class: META
  membershipEpoch    BigInt          @default(0) @map("membership_epoch")
  /// class: META
  status             RoomStatus      @default(ACTIVE)
  /// class: ID
  createdById        String          @map("created_by_id") @db.Uuid
  /// class: META
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// class: META
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)

  createdBy       User             @relation("RoomCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members         RoomMember[]
  invitations     Invitation[]
  keyVersions     RoomKeyVersion[]
  rekeyOperations RekeyOperation[]
  envelopes       KeyEnvelope[]
  files           EncryptedFile[]
  notes           EncryptedNote[]
  secrets         Secret[]

  @@index([createdById])
  @@map("rooms")
}

/// data-model 4.7. Membership loaded from here drives every authorization decision (INV-05).
model RoomMember {
  /// class: ID
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: ID
  roomId          String           @map("room_id") @db.Uuid
  /// class: ID
  userId          String           @map("user_id") @db.Uuid
  /// class: META
  role            RoomRole
  /// class: META
  status          MembershipStatus @default(ACTIVE)
  /// class: META
  firstKeyVersion Int              @map("first_key_version")
  /// class: ID
  addedById       String?          @map("added_by_id") @db.Uuid
  /// class: ID
  invitationId    String?          @map("invitation_id") @db.Uuid
  /// class: META
  joinedAt        DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  /// class: META
  removedAt       DateTime?        @map("removed_at") @db.Timestamptz(3)
  /// class: ID
  removedById     String?          @map("removed_by_id") @db.Uuid
  /// class: META
  removalReason   RemovalReason?   @map("removal_reason")

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user       User        @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addedBy    User?       @relation("MemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedBy  User?       @relation("MemberRemovedBy", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // The invitation must belong to the same room.
  invitation Invitation? @relation(fields: [invitationId, roomId], references: [id, roomId], onDelete: Restrict, onUpdate: Restrict)

  // Object-level authorization lookup (roomId, userId) is served by the partial unique index.
  @@unique([roomId, userId], map: "room_members_one_current_membership", where: raw("status = 'ACTIVE' OR status = 'SUSPENDED'"))
  @@unique([roomId], map: "room_members_one_active_owner", where: raw("role = 'OWNER' AND status = 'ACTIVE'"))
  @@index([userId, status])
  @@index([roomId, status])
  @@map("room_members")
}

/// data-model 4.8. In-app invitations only: there is no bearer token or link secret.
model Invitation {
  /// class: ID
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: ID
  roomId               String           @map("room_id") @db.Uuid
  /// class: ID
  inviteeUserId        String           @map("invitee_user_id") @db.Uuid
  /// class: ID (the key the pending envelopes were wrapped for)
  inviteeKeyId         String           @map("invitee_key_id") @db.Uuid
  /// class: ID
  invitedById          String           @map("invited_by_id") @db.Uuid
  /// class: META
  role                 InvitationRole
  /// class: META
  status               InvitationStatus
  /// class: ID
  approvedById         String?          @map("approved_by_id") @db.Uuid
  /// class: META
  approvedAt           DateTime?        @map("approved_at") @db.Timestamptz(3)
  /// class: INT (fingerprint the inviter confirmed; required in RESTRICTED rooms)
  confirmedFingerprint String?          @map("confirmed_fingerprint") @db.Char(64)
  /// class: META
  expiresAt            DateTime         @map("expires_at") @db.Timestamptz(3)
  /// class: META
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  respondedAt          DateTime?        @map("responded_at") @db.Timestamptz(3)

  room       Room          @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitee    User          @relation("InvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // The invitee key must belong to the invitee.
  inviteeKey UserKeyPair   @relation(fields: [inviteeKeyId, inviteeUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  invitedBy  User          @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy User?         @relation("InvitationApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members    RoomMember[]
  envelopes  KeyEnvelope[]

  // Composite key target for memberships and envelopes in the same room.
  @@unique([id, roomId])
  @@unique([roomId, inviteeUserId], map: "invitations_one_open_per_invitee", where: raw("status = 'PENDING_APPROVAL' OR status = 'PENDING'"))
  @@index([inviteeUserId, status])
  @@index([roomId, status])
  @@index([expiresAt], map: "invitations_open_expiry_idx", where: raw("status = 'PENDING_APPROVAL' OR status = 'PENDING'"))
  @@map("invitations")
}

/// data-model 4.9. Holds only the public commitment, never key material (INV-04).
model RoomKeyVersion {
  /// class: ID
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: ID
  roomId               String             @map("room_id") @db.Uuid
  /// class: META
  version              Int
  /// class: META
  status               KeyVersionStatus
  /// class: INT (RKC_v from HKDF, written once, never the key itself)
  commitment           Bytes
  /// class: META
  algorithmSuite       String             @map("algorithm_suite") @db.VarChar(16)
  /// class: META
  reasons              KeyVersionReason[]
  /// class: ID (NULL for version 1, and after the operation row is purged)
  createdByOperationId String?            @map("created_by_operation_id") @db.Uuid
  /// class: META
  wrapCount            Int                @default(0) @map("wrap_count")
  /// class: ID
  createdById          String             @map("created_by_id") @db.Uuid
  /// class: META
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  retiredAt            DateTime?          @map("retired_at") @db.Timestamptz(3)
  /// class: META
  destroyedAt          DateTime?          @map("destroyed_at") @db.Timestamptz(3)

  room               Room            @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy          User            @relation("KeyVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // Operations are purged 90 days after closing (data-model section 5); the version row stays.
  createdByOperation RekeyOperation? @relation(fields: [createdByOperationId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  envelopes          KeyEnvelope[]
  files              EncryptedFile[]
  notes              EncryptedNote[]

  @@unique([roomId, version])
  @@unique([roomId], map: "room_key_versions_one_active_per_room", where: raw("status = 'ACTIVE'"))
  @@index([createdByOperationId])
  @@map("room_key_versions")
}

/// data-model 4.9.1 and ADR-013. Holds no key material; envelopes arrive only at finalize.
model RekeyOperation {
  /// class: ID
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: ID
  roomId             String      @map("room_id") @db.Uuid
  /// class: ID
  startedById        String      @map("started_by_id") @db.Uuid
  /// class: META
  mode               RekeyMode
  /// class: META
  status             RekeyStatus @default(PENDING)
  /// class: META
  baseVersion        Int         @map("base_version")
  /// class: META
  targetVersion      Int         @map("target_version")
  /// class: META
  membershipEpoch    BigInt      @map("membership_epoch")
  /// class: INT (SHA-256 over the canonical recipient set)
  recipientSetDigest Bytes       @map("recipient_set_digest")
  /// class: META
  leaseExpiresAt     DateTime    @map("lease_expires_at") @db.Timestamptz(3)
  /// class: INT (SHA-256 of the canonical finalize payload, for idempotency)
  payloadDigest      Bytes?      @map("payload_digest")
  /// class: META
  closedReason       String?     @map("closed_reason") @db.VarChar(64)
  /// class: META
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  completedAt        DateTime?   @map("completed_at") @db.Timestamptz(3)
  /// class: META
  closedAt           DateTime?   @map("closed_at") @db.Timestamptz(3)

  room              Room             @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  startedBy         User             @relation(fields: [startedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activatedVersions RoomKeyVersion[]

  // Operations are always loaded together with their room (OL-13).
  @@unique([id, roomId])
  @@unique([roomId], map: "rekey_operations_one_pending_per_room", where: raw("status = 'PENDING'"))
  @@index([leaseExpiresAt], map: "rekey_operations_pending_lease_idx", where: raw("status = 'PENDING'"))
  @@index([closedAt])
  @@map("rekey_operations")
}

/// data-model 4.10. RSA-OAEP-3072 envelopes of 32-byte room key material, one per recipient key.
/// Created only by member browsers; the server stores and serves them (INV-04).
model KeyEnvelope {
  /// class: ID
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: ID
  roomId          String         @map("room_id") @db.Uuid
  /// class: META
  keyVersion      Int            @map("key_version")
  /// class: ID
  recipientUserId String         @map("recipient_user_id") @db.Uuid
  /// class: ID
  recipientKeyId  String         @map("recipient_key_id") @db.Uuid
  /// class: ID (set while the envelope belongs to a pending invitation)
  invitationId    String?        @map("invitation_id") @db.Uuid
  /// class: META
  status          EnvelopeStatus
  /// class: WK (RSA-OAEP-3072 ciphertext of RKM_v)
  wrappedKey      Bytes          @map("wrapped_key")
  /// class: META
  algorithm       String         @db.VarChar(32)
  /// class: ID
  createdById     String         @map("created_by_id") @db.Uuid
  /// class: META
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keyVersionRef RoomKeyVersion @relation(fields: [roomId, keyVersion], references: [roomId, version], onDelete: Restrict, onUpdate: Restrict)
  // The recipient key must belong to the recipient user.
  recipientKey  UserKeyPair    @relation(fields: [recipientKeyId, recipientUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  invitation    Invitation?    @relation(fields: [invitationId, roomId], references: [id, roomId], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User           @relation("EnvelopeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roomId, keyVersion, recipientKeyId])
  // Envelope fetch and deletion per member (removal deletes all envelopes of that member).
  @@index([roomId, recipientUserId])
  @@index([recipientKeyId])
  @@index([invitationId])
  @@map("key_envelopes")
}

// ---------------------------------------------------------------------------------------------
// Encrypted content
// ---------------------------------------------------------------------------------------------

/// data-model 4.11. File bytes live only in object storage as ciphertext; this row holds the
/// wrapped FEK and the encrypted manifest (filename, MIME type, size, plaintext hash) (INV-16).
model EncryptedFile {
  /// class: ID (client-generated; part of the file AAD)
  id                 String     @id @db.Uuid
  /// class: ID
  roomId             String     @map("room_id") @db.Uuid
  /// class: ID
  uploaderId         String     @map("uploader_id") @db.Uuid
  /// class: META
  keyVersion         Int        @map("key_version")
  /// class: META
  status             FileStatus @default(PENDING_UPLOAD)
  /// class: META
  algorithmSuite     String     @map("algorithm_suite") @db.VarChar(16)
  /// class: WK (FEK wrapped under RWK_v with AES-256-GCM; NULL once deleted)
  wrappedDek         Bytes?     @map("wrapped_dek")
  /// class: META (IV, not secret)
  dekIv              Bytes      @map("dek_iv")
  /// class: META (IV, not secret)
  contentIv          Bytes      @map("content_iv")
  /// class: CT (encrypted manifest; NULL once deleted)
  manifestCiphertext Bytes?     @map("manifest_ciphertext")
  /// class: META (IV, not secret)
  manifestIv         Bytes      @map("manifest_iv")
  /// class: META (random, server-generated; never derived from the filename)
  objectKey          String     @unique @map("object_key") @db.VarChar(128)
  /// class: META (reveals approximate file size, T-28)
  ciphertextSize     BigInt     @map("ciphertext_size")
  /// class: INT (SHA-256 of the ciphertext, not the plaintext)
  ciphertextSha256   Bytes      @map("ciphertext_sha256")
  /// class: META
  expiresAt          DateTime?  @map("expires_at") @db.Timestamptz(3)
  /// class: META
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  uploadedAt         DateTime?  @map("uploaded_at") @db.Timestamptz(3)
  /// class: META
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)

  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keyVersionRef RoomKeyVersion @relation(fields: [roomId, keyVersion], references: [roomId, version], onDelete: Restrict, onUpdate: Restrict)
  uploader      User           @relation(fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([roomId, status, createdAt])
  @@index([uploaderId])
  @@index([expiresAt], map: "encrypted_files_live_expiry_idx", where: raw("status <> 'DELETED' AND expires_at IS NOT NULL"))
  @@map("encrypted_files")
}

/// data-model 4.12. One row per note; every save replaces the ciphertext under a fresh NEK.
model EncryptedNote {
  /// class: ID (client-generated; part of the note AAD)
  id               String    @id @db.Uuid
  /// class: ID
  roomId           String    @map("room_id") @db.Uuid
  /// class: ID
  authorId         String    @map("author_id") @db.Uuid
  /// class: ID
  updatedById      String    @map("updated_by_id") @db.Uuid
  /// class: META
  revision         Int
  /// class: META
  keyVersion       Int       @map("key_version")
  /// class: META
  algorithmSuite   String    @map("algorithm_suite") @db.VarChar(16)
  /// class: WK (NEK wrapped under RWK_v with AES-256-GCM; NULL once deleted)
  wrappedDek       Bytes?    @map("wrapped_dek")
  /// class: META (IV, not secret)
  dekIv            Bytes     @map("dek_iv")
  /// class: CT (encrypted JSON with title and body; NULL once deleted)
  ciphertext       Bytes?
  /// class: META (IV, not secret)
  contentIv        Bytes     @map("content_iv")
  /// class: INT (SHA-256 of the ciphertext)
  ciphertextSha256 Bytes     @map("ciphertext_sha256")
  /// class: META
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  /// class: META
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// class: META
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  keyVersionRef RoomKeyVersion @relation(fields: [roomId, keyVersion], references: [roomId, version], onDelete: Restrict, onUpdate: Restrict)
  author        User           @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy     User           @relation("NoteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([roomId, updatedAt])
  @@index([authorId])
  @@index([updatedById])
  @@index([expiresAt], map: "encrypted_notes_live_expiry_idx", where: raw("deleted_at IS NULL AND expires_at IS NOT NULL"))
  @@map("encrypted_notes")
}

/// data-model 4.13. The payload is AES-256-GCM ciphertext under a 32-byte SEK; only the SEK is
/// RSA-OAEP-wrapped to the recipient key (INV-17). Both are set to NULL on burn, expiry or revoke.
model Secret {
  /// class: ID (client-generated; part of the secret AAD and OAEP label)
  id                String       @id @db.Uuid
  /// class: ID
  roomId            String       @map("room_id") @db.Uuid
  /// class: ID
  senderId          String       @map("sender_id") @db.Uuid
  /// class: ID
  recipientUserId   String       @map("recipient_user_id") @db.Uuid
  /// class: ID
  recipientKeyId    String       @map("recipient_key_id") @db.Uuid
  /// class: META
  status            SecretStatus @default(ACTIVE)
  /// class: META
  burnAfterReading  Boolean      @map("burn_after_reading")
  /// class: META
  algorithmSuite    String       @map("algorithm_suite") @db.VarChar(16)
  /// class: WK (RSA-OAEP-3072 wrap of the SEK; NULL once burned, expired or revoked)
  wrappedSek        Bytes?       @map("wrapped_sek")
  /// class: META
  wrapAlgorithm     String       @map("wrap_algorithm") @db.VarChar(32)
  /// class: CT (AES-256-GCM output under the SEK; NULL together with wrappedSek)
  payloadCiphertext Bytes?       @map("payload_ciphertext")
  /// class: META (IV, not secret)
  payloadIv         Bytes?       @map("payload_iv")
  /// class: META
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  /// class: META
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// class: META
  revealedAt        DateTime?    @map("revealed_at") @db.Timestamptz(3)
  /// class: META
  destroyedAt       DateTime?    @map("destroyed_at") @db.Timestamptz(3)

  room         Room        @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sender       User        @relation("SecretSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // The recipient key must belong to the recipient user.
  recipientKey UserKeyPair @relation(fields: [recipientKeyId, recipientUserId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([roomId, recipientUserId, status])
  @@index([roomId, senderId])
  @@index([recipientKeyId, recipientUserId])
  @@index([senderId])
  @@index([expiresAt], map: "secrets_active_expiry_idx", where: raw("status = 'ACTIVE'"))
  @@map("secrets")
}

// ---------------------------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------------------------

/// data-model 4.15. Append-only (INV-09): a trigger rejects UPDATE, DELETE and TRUNCATE, and
/// runtime roles hold only SELECT and INSERT. The hash chain (ADR-009, CP-13) is computed by the
/// audit module in Phase 12; this phase only stores its columns. No foreign keys, so audit rows
/// outlive the records they describe.
model AuditEvent {
  /// class: META (gap-free sequence, assigned under the chain-head lock in Phase 12)
  seq         BigInt         @id
  /// class: ID
  id          String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// class: META
  occurredAt  DateTime       @map("occurred_at") @db.Timestamptz(3)
  /// class: META
  actorType   AuditActorType @map("actor_type")
  /// class: META (pseudonymous user ID)
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// class: META (catalogued action name)
  action      String         @db.VarChar(64)
  /// class: META
  outcome     AuditOutcome
  /// class: META
  roomId      String?        @map("room_id") @db.Uuid
  /// class: META
  targetType  String?        @map("target_type") @db.VarChar(32)
  /// class: META
  targetId    String?        @map("target_id") @db.Uuid
  /// class: META
  requestId   String?        @map("request_id") @db.VarChar(64)
  /// class: META (allowlisted keys per action; no secrets, content or IP addresses)
  details     Json           @default("{}")
  /// class: INT
  prevHash    Bytes          @map("prev_hash")
  /// class: INT
  eventHash   Bytes          @map("event_hash")
  /// class: META
  hashVersion Int            @map("hash_version")

  @@index([roomId, seq])
  @@index([actorUserId, seq])
  @@index([occurredAt])
  @@map("audit_events")
}
