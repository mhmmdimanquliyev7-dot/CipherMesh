#!/usr/bin/env bash
# cm-secrets: creates the runtime secrets of the cloud demonstration on the VM (ADR-014,
# deployment-architecture.md section 5, CM-T071). Run once; it refuses to overwrite existing files.
#
#   sudo cm-secrets
#
# Creates in CM_SECRETS_DIR (directory 0700 root):
#   api_database_url, worker_database_url, totp_encryption_key, identifier_hmac_key,
#   storage_secret_access_key
#                                one value per file, owner uid 10001 (the API and worker
#                                containers' user, no host account), mode 0400; mounted read-only
#                                under /run/secrets, so no secret is an environment variable
#   api.env, worker.env          non-secret identifiers only (TOTP key ID, storage access key ID)
#   seaweedfs-identities.json    the single storage identity (uid 1000, the SeaweedFS user, 0400):
#                                read and write objects in one bucket, nothing else
# Every value is random and generated here; none is printed. The migration (schema owner)
# password is NOT created here: it stays on the operator's workstation (cm-db-init, cm-migrate).
# The verifier role gets a random password that is not stored: it is unused until Phase 12.
. "$(dirname "$0")/cm-lib.sh"
cm_require openssl
cm_load_config

bucket="${CM_STORAGE_BUCKET:-cm-files}"
[[ "${bucket}" =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || cm_die 'CM_STORAGE_BUCKET is not a valid bucket name'
mkdir -p "${CM_SECRETS_DIR}"
chmod 700 "${CM_SECRETS_DIR}"
SECRET_FILES=(api_database_url worker_database_url totp_encryption_key identifier_hmac_key storage_secret_access_key)
for file in "${SECRET_FILES[@]}" api.env worker.env seaweedfs-identities.json; do
  [[ ! -e "${CM_SECRETS_DIR}/${file}" ]] || cm_die "${file} exists; secrets are never overwritten (rotate with the runbook)"
done

secret() { # <name> <value>
  printf '%s\n' "$2" | cm_write_private "${CM_SECRETS_DIR}/$1"
  cm_give 10001 "${CM_SECRETS_DIR}/$1"
}

db_query='sslmode=verify-full&sslrootcert=/etc/ciphermesh/db-ca/ca.crt'
storage_key="cmrt$(cm_random_hex 8)"
storage_secret="$(cm_random_hex 24)"
totp_key="$(cm_random_key)"
hmac_key="$(cm_random_key)"
[[ "${totp_key}" != "${hmac_key}" ]] || cm_die 'random keys collided'

secret api_database_url "postgresql://cm_api:$(cm_random_hex 24)@postgres:5432/ciphermesh?${db_query}"
secret worker_database_url "postgresql://cm_worker:$(cm_random_hex 24)@postgres:5432/ciphermesh?${db_query}"
secret totp_encryption_key "${totp_key}"
secret identifier_hmac_key "${hmac_key}"
secret storage_secret_access_key "${storage_secret}"

cm_write_private "${CM_SECRETS_DIR}/api.env" << EOF
# CipherMesh API: non-secret identifiers (cm-secrets, $(date -u +%Y-%m-%d)). The secrets are files.
TOTP_ENCRYPTION_KEY_ID=cloud-$(date -u +%Y-%m)
STORAGE_ACCESS_KEY_ID=${storage_key}
EOF
cm_write_private "${CM_SECRETS_DIR}/worker.env" << EOF
# CipherMesh worker: non-secret identifiers (cm-secrets, $(date -u +%Y-%m-%d)).
STORAGE_ACCESS_KEY_ID=${storage_key}
EOF
# One identity, no administrator: the bucket is created with "weed shell" inside the container
# (cm-storage-init), so no S3 credential with Admin or List rights exists anywhere.
cm_write_private "${CM_SECRETS_DIR}/seaweedfs-identities.json" << EOF
{"identities": [{"name": "cm-runtime",
  "credentials": [{"accessKey": "${storage_key}", "secretKey": "${storage_secret}"}],
  "actions": ["Read:${bucket}", "Write:${bucket}"]}]}
EOF
cm_give 1000 "${CM_SECRETS_DIR}/seaweedfs-identities.json"
cm_info "runtime secrets written to ${CM_SECRETS_DIR}; values were not printed"
