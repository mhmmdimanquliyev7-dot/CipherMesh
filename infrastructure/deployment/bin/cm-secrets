#!/usr/bin/env bash
# cm-secrets: creates the runtime secrets of the cloud demonstration on the VM (ADR-014,
# deployment-architecture.md section 5). Run once; it refuses to overwrite existing files.
#
#   sudo cm-secrets
#
# Creates, mode 0600 root, in CM_SECRETS_DIR:
#   api.env                      cm_api database URL, TOTP and identifier keys, storage runtime key
#   worker.env                   cm_worker database URL, storage runtime key
#   seaweedfs-identities.json    the single storage identity: read and write objects in one bucket
# Every value is random and generated here; none is printed. The migration (schema owner)
# password is NOT created here: it stays on the operator's workstation (cm-db-init, cm-migrate).
# The verifier role gets a random password that is not stored: it is unused until Phase 12.
. "$(dirname "$0")/cm-lib.sh"
cm_require openssl
cm_load_config

bucket="${CM_STORAGE_BUCKET:-cm-files}"
[[ "${bucket}" =~ ^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$ ]] || cm_die 'CM_STORAGE_BUCKET is not a valid bucket name'
mkdir -p "${CM_SECRETS_DIR}"
chmod 700 "${CM_SECRETS_DIR}"
for file in api.env worker.env seaweedfs-identities.json; do
  [[ ! -e "${CM_SECRETS_DIR}/${file}" ]] || cm_die "${file} exists; secrets are never overwritten (rotate with the runbook)"
done

db_query='sslmode=verify-full&sslrootcert=/etc/ciphermesh/db-ca/ca.crt'
api_password="$(cm_random_hex 24)"
worker_password="$(cm_random_hex 24)"
storage_key="cmrt$(cm_random_hex 8)"
storage_secret="$(cm_random_hex 24)"
totp_key="$(cm_random_key)"
hmac_key="$(cm_random_key)"
[[ "${totp_key}" != "${hmac_key}" ]] || cm_die 'random keys collided'

cm_write_private "${CM_SECRETS_DIR}/api.env" << EOF
# CipherMesh API runtime secrets (cm-secrets, $(date -u +%Y-%m-%d)). Never copy into Git, tickets or chat.
DATABASE_URL=postgresql://cm_api:${api_password}@postgres:5432/ciphermesh?${db_query}
TOTP_ENCRYPTION_KEY=${totp_key}
TOTP_ENCRYPTION_KEY_ID=cloud-$(date -u +%Y-%m)
IDENTIFIER_HMAC_KEY=${hmac_key}
STORAGE_ACCESS_KEY_ID=${storage_key}
STORAGE_SECRET_ACCESS_KEY=${storage_secret}
EOF
cm_write_private "${CM_SECRETS_DIR}/worker.env" << EOF
# CipherMesh worker runtime secrets (cm-secrets, $(date -u +%Y-%m-%d)).
WORKER_DATABASE_URL=postgresql://cm_worker:${worker_password}@postgres:5432/ciphermesh?${db_query}
STORAGE_ACCESS_KEY_ID=${storage_key}
STORAGE_SECRET_ACCESS_KEY=${storage_secret}
EOF
# One identity, no administrator: the bucket is created with "weed shell" inside the container
# (cm-storage-init), so no S3 credential with Admin or List rights exists anywhere.
cm_write_private "${CM_SECRETS_DIR}/seaweedfs-identities.json" << EOF
{"identities": [{"name": "cm-runtime",
  "credentials": [{"accessKey": "${storage_key}", "secretKey": "${storage_secret}"}],
  "actions": ["Read:${bucket}", "Write:${bucket}"]}]}
EOF
# SeaweedFS runs as its image's unprivileged user (uid 1000), which must read its identity file.
if chown 1000:1000 "${CM_SECRETS_DIR}/seaweedfs-identities.json" 2> /dev/null; then
  chmod 400 "${CM_SECRETS_DIR}/seaweedfs-identities.json"
elif [[ "${CM_REHEARSAL:-}" == 1 ]]; then
  # Local rehearsal without root: the throwaway file is made readable for the container user.
  chmod 444 "${CM_SECRETS_DIR}/seaweedfs-identities.json"
else
  cm_die 'could not give the storage identity file to uid 1000 (run cm-secrets as root)'
fi
cm_info "runtime secrets written to ${CM_SECRETS_DIR} (mode 0600); values were not printed"
