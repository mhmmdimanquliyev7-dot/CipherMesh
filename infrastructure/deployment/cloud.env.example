# CipherMesh cloud demonstration: NON-SECRET configuration (ADR-014). Copy to
# /srv/ciphermesh/config/cloud.env on the VM (mode 0644, owner root). Secrets never go here: the
# runtime secrets are generated on the VM by cm-secrets into /srv/ciphermesh/secrets (mode 0600),
# and the migration password and the backup identity stay on the operator's workstation.

# Release deployed (first 12 hex characters of the commit); maintained by cm-deploy.
CM_RELEASE=
CM_PREVIOUS_RELEASE=

# The two public host names (two DuckDNS names, both pointing to the VM's public IPv4 address).
# They must differ: presigned storage URLs never point to the application's host (SF-07-01).
CM_APP_HOST=example-app.duckdns.org
CM_FILES_HOST=example-files.duckdns.org

# The content bucket (created by cm-storage-init).
CM_STORAGE_BUCKET=cm-files

# HSTS max-age in seconds. 0 until HTTPS and certificate renewal are verified (cm-tls renew-test),
# then 86400 for the demonstration. No includeSubDomains, no preload.
CM_HSTS_MAX_AGE=0

# age recipient (PUBLIC key, age1...) that backups are encrypted to. The matching identity
# (private key) stays offline with the operator: the VM can write backups but not read them.
CM_BACKUP_RECIPIENT=

# Optional: days to keep backups on the VM (the newest three are always kept).
CM_BACKUP_KEEP_DAYS=7
