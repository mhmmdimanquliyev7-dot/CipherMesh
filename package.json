{
  "name": "ciphermesh",
  "private": true,
  "description": "CipherMesh: client-side encrypted secure collaboration and secret exchange (university security project)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ciphermesh/api --filter @ciphermesh/web dev",
    "build": "pnpm --recursive build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck && tsc --project tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test",
    "smoke:api": "node scripts/smoke-api.mjs",
    "audit:deps": "pnpm audit --audit-level high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --lockfile-only --prod --recursive --out sbom.cdx.json",
    "services:up": "docker compose --file infrastructure/docker/compose.dev.yml --env-file .env up --detach --wait",
    "services:down": "docker compose --file infrastructure/docker/compose.dev.yml --env-file .env down"
  },
  "devDependencies": {
    "@ciphermesh/shared": "workspace:*",
    "@ciphermesh/validation": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
