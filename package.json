{
  "name": "ciphermesh",
  "private": true,
  "description": "CipherMesh: client-side encrypted secure collaboration and secret exchange (university security project)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ciphermesh/api --filter @ciphermesh/web dev",
    "build": "pnpm --recursive build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive typecheck && tsc --project tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:database": "vitest run --project database",
    "test:e2e": "playwright test",
    "smoke:api": "node scripts/smoke-api.mjs",
    "audit:deps": "pnpm audit --audit-level high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --lockfile-only --prod --recursive --out sbom.cdx.json",
    "services:up": "docker compose --file infrastructure/docker/compose.dev.yml --env-file .env up --detach --wait",
    "services:down": "docker compose --file infrastructure/docker/compose.dev.yml --env-file .env down",
    "db:bootstrap": "node scripts/db/bootstrap.mjs",
    "db:migrate": "node scripts/db/prisma.mjs migrate deploy",
    "db:status": "node scripts/db/prisma.mjs migrate status",
    "db:generate": "node scripts/db/prisma.mjs generate",
    "db:validate": "node scripts/db/prisma.mjs validate",
    "db:drift": "node scripts/db/check-drift.mjs",
    "db:check-schema": "node scripts/db/check-schema.mjs",
    "db:seed": "node --import tsx scripts/db/seed.ts",
    "postinstall": "node scripts/db/prisma.mjs generate"
  },
  "devDependencies": {
    "@ciphermesh/shared": "workspace:*",
    "@ciphermesh/validation": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "pg": "catalog:",
    "prettier": "3.9.9",
    "prisma": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
