# Copy to .env for local development and replace every placeholder locally.
# PLACEHOLDERS ONLY: never commit .env, and never reuse development values anywhere else.

# API (apps/api/src/config/env.ts validates these at startup)
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
LOG_LEVEL=info
# The only origin allowed to send state-changing requests (INV-19).
# Local HTTPS through Nginx arrives with sessions in Phase 3.
APP_ORIGIN=https://localhost:8443

# Development-only services (infrastructure/docker/compose.dev.yml), bound to 127.0.0.1.
# The API uses PostgreSQL from Phase 2 and object storage from Phase 7. POSTGRES_* is the local
# container administrator, used only by `pnpm db:bootstrap` and the database tests, never by the API.
POSTGRES_DB=ciphermesh_dev
POSTGRES_USER=ciphermesh_dev
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=55432
S3_ACCESS_KEY_ID=replace-with-a-local-only-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-local-only-secret-key
S3_PORT=8333

# Database roles (CM-T014, docs/security/database-security.md). `pnpm db:bootstrap` creates the
# roles and the `ciphermesh` database on the local container, using the POSTGRES_* admin account.
# Role names are fixed because the grant migration names them. Use long random local passwords.
# Migration role: owns the schema. Used by Prisma Migrate only; never deployed to the VM.
MIGRATION_DATABASE_URL=postgresql://cm_migrator:replace-with-a-local-only-password@127.0.0.1:55432/ciphermesh
# API runtime role: DML on application tables, SELECT and INSERT on audit_events, no DDL.
DATABASE_URL=postgresql://cm_api:replace-with-a-local-only-password@127.0.0.1:55432/ciphermesh
# Worker and audit-verifier roles (used from Phase 12 and later; created now with their grants).
WORKER_DATABASE_URL=postgresql://cm_worker:replace-with-a-local-only-password@127.0.0.1:55432/ciphermesh
VERIFIER_DATABASE_URL=postgresql://cm_verifier:replace-with-a-local-only-password@127.0.0.1:55432/ciphermesh
